<Project Sdk="Microsoft.NET.Sdk">
  <!-- Acervo para Windows: mesma lógica do app do Mac, em C# com Avalonia. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Acervo</AssemblyName>
    <RootNamespace>Acervo</RootNamespace>
    <Version>2.0.0</Version>
    <Product>Acervo</Product>
    <ApplicationIcon>Assets/acervo.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;pt;es</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <!-- Fonte Inter (licença OFL): acentos certos em qualquer Windows -->
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.14" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- O PDFsharp traz a 8.0.1, com falha de segurança conhecida (GHSA-846f-f764-76mx) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <!-- Os testes do motor ficam num projeto à parte -->
    <Compile Remove="tests/**;tests-ui/**" />
  </ItemGroup>
</Project>
